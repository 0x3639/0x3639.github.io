---
import { site } from '../data/site';
---

<header class="banner">
  <a href="/" aria-label={`${site.title} home`}>
    <pre aria-hidden="true"> ██████  ██   ██ ██████   ██████  ██████   ██████
██    ██  ██ ██       ██ ██            ██ ██    ██
██    ██   ███    █████  ███████   █████  ██    ██
██    ██  ██ ██       ██ ██    ██      ██  ███████
 ██████  ██   ██ ██████   ██████  ██████        ██</pre>
    <h1 class="sr-only">{site.title}</h1>
  </a>
</header>

<style>
  .banner a {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  pre {
    margin: 0 0 24px;
    font-weight: bold;
    line-height: 1.05;
    /* 50 columns wide; shrink with the viewport so it never scrolls */
    font-size: clamp(7px, 1.7vw, 15px);
    color: var(--fg-bright);
    text-shadow: 0 0 8px rgba(77, 220, 77, 0.45);
    letter-spacing: 0;
    overflow: hidden;
  }
</style>
