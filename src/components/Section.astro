---
/**
 * A titled section: "## TITLE" heading in the design's style, then whatever
 * is slotted in. The id is the anchor the nav links to.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section">
  <h2><span class="hash">##</span> {title}</h2>
  <slot />
</section>

<style>
  .section {
    scroll-margin-top: 16px;
  }
  h2 {
    margin: 0 0 10px;
    font: bold 16px/1.4 inherit;
    color: var(--fg-text);
    text-transform: uppercase;
  }
  .hash {
    color: var(--fg-bright);
  }
</style>
