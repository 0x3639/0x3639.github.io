---
import { nav } from '../data/site';
---

<nav class="brackets nav" aria-label="Sections">
  {nav.map((item) => <span>[ <a href={item.href}>{item.label}</a> ]</span>)}
</nav>

<style>
  .nav {
    justify-content: center;
    text-align: center;
    gap: 8px 14px;
    margin: 0 0 16px;
  }
  .nav a {
    display: inline-block;
    padding: 4px 2px;
  }
</style>
