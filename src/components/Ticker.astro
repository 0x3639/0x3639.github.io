---
import { ticker } from '../data/site';

// "*** A *** B *** C ***" — repeated twice so the CSS marquee can loop seamlessly.
const line = `*** ${ticker.join(' *** ')} *** `;
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    <span>{line}</span>
    <span>{line}</span>
  </div>
</div>

<style>
  .ticker {
    white-space: nowrap;
    overflow: hidden;
    color: var(--fg-dim);
    border-top: 1px solid var(--ticker-border);
    border-bottom: 1px solid var(--ticker-border);
    padding: 2px 0;
    margin: 0 0 14px;
    font-size: 14px;
  }
  .ticker__track {
    display: inline-block;
  }
  .ticker__track span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker__track {
      animation: ticker 60s linear infinite;
    }
    @keyframes ticker {
      to {
        transform: translateX(-50%);
      }
    }
  }
</style>
